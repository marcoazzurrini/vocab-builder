{
  "name": "vocab-builder",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @vocab/web dev",
    "build": "bun run --filter @vocab/web build",
    "ci": "bun run build && bun run check",
    "preview": "bun run --filter @vocab/web preview",
    "prepare": "lefthook install",
    "lint": "oxlint && bun run boundaries",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "test": "bun run --filter '*' test",
    "test:watch": "bun run --filter '*' test:watch",
    "boundaries": "depcruise --config .dependency-cruiser.cjs apps packages",
    "db:test": "bun run --filter @vocab/database --filter @vocab/authentication test",
    "cf:types": "bun run --filter @vocab/web cf:types",
    "db:generate": "bun run --filter @vocab/database generate",
    "db:migrate": "bun run --filter @vocab/web db:migrate",
    "db:migrate:remote": "bun run --filter @vocab/web db:migrate:remote",
    "db:seed": "bun packages/database/scripts/import-catalogue.ts --config apps/web/wrangler.jsonc",
    "deploy": "bun run ci && bun run deploy:only",
    "deploy:only": "bun run --filter @vocab/web deploy",
    "setup:local": "bun apps/web/scripts/setup-local.mjs apps/web/.dev.vars"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "dependency-cruiser": "^18.3.1",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.75.0",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "workerd"
  ]
}
