{
  "name": "vocab-builder",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @vocab/web dev",
    "build": "bun run --filter @vocab/web build",
    "ci": "bun run build && bun run check",
    "preview": "bun run --filter @vocab/web preview",
    "prepare": "lefthook install",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "test": "bun run --filter '*' test",
    "test:watch": "bun run --filter '*' test:watch",
    "db:test": "bun run --filter @vocab/web db:test",
    "cf:types": "bun run --filter @vocab/web cf:types",
    "db:generate": "bun run --filter @vocab/web db:generate",
    "db:migrate": "bun run --filter @vocab/web db:migrate",
    "db:migrate:remote": "bun run --filter @vocab/web db:migrate:remote",
    "db:seed": "bun run --filter @vocab/web db:seed",
    "db:export-words": "bun run --filter @vocab/web db:export-words",
    "deploy": "bun run ci && bun run deploy:only",
    "deploy:only": "bun run --filter @vocab/web deploy",
    "setup:local": "bun run --filter @vocab/web setup:local"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.75.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "workerd"
  ]
}
