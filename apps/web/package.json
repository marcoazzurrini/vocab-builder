{
  "name": "@vocab/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "bun run cf:types && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test": "vitest run src/server/db/repository.test.ts src/server/auth.test.ts",
    "cf:types": "mkdir -p .generated && wrangler types .generated/cloudflare.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "bun scripts/seed-words.mjs",
    "db:export-words": "bun scripts/export-supabase-words.mjs",
    "deploy": "wrangler deploy",
    "setup:local": "bun scripts/setup-local.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@tanstack/react-router": "^1.170.35",
    "@tanstack/react-start": "^1.168.52",
    "@vocab/study": "workspace:*",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ts-fsrs": "^5.4.1",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.8",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
