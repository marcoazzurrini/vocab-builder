# Build output
dist/
dist-ssr/
build/
*.local

# Environment
#
# *.local files hold real secrets (service role keys, the Azure key later) and
# never leave the machine. Plain .env files hold the Supabase URL and publishable
# key, which are compiled into the client bundle and served to every visitor —
# public by construction, protected by RLS rather than by secrecy.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
.wrangler/
.tanstack/
src/routeTree.gen.ts
exports/

