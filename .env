# Committed on purpose.
#
# Vite compiles VITE_* values into the JS bundle, so both of these are served to
# every visitor whatever we do — putting them in a secret store would hide them
# from us, not from anyone else. The publishable key grants only what the `anon`
# role is allowed, and RLS grants `anon` nothing: a signed-out request for the
# word list returns zero rows, verified against the live project.
#
# Real secrets (service role, the Azure key later) go in .env.local, which is
# gitignored, or into Supabase/Cloudflare secret storage. Never here.
#
# To develop against the local stack instead, put these two keys in .env.local
# with the values printed by `supabase start`.

VITE_SUPABASE_URL=https://zetfjxwowpxgvzraiqos.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EUF7_of4GNsithxLgeu6uQ_rcWHXDLO
