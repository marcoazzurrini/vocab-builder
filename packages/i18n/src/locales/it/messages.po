#: ../../apps/web/src/shell/sidebar.tsx
msgid "Menu"
msgstr "Menu"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "new word · take a guess"
msgstr "parola nuova · prova a indovinare"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Next word in about {minutes} min. Your session will resume automatically."
msgstr "La prossima parola sarà pronta tra circa {minutes} min. La sessione riprenderà da sola."

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "not quite"
msgstr "non proprio"

#: ../../apps/web/src/shell/app-shell.tsx
msgid "Open menu"
msgstr "Apri menu"

#: ../../apps/web/src/shell/sidebar.tsx
msgid "Progress"
msgstr "Progressi"

#: ../../apps/web/src/shell/error-boundary.tsx
msgid "Reload"
msgstr "Ricarica la pagina"

#: ../../apps/web/src/features/sign-in/sign-in.tsx
msgid "Request another link"
msgstr "Richiedi un altro link"

#: ../../apps/web/src/features/sign-in/sign-in.tsx
msgid "Send link"
msgstr "Invia link"

#: ../../apps/web/src/features/sign-in/sign-in.tsx
msgid "Sending…"
msgstr "Invio in corso…"

#: ../../apps/web/src/shell/sidebar.tsx
msgid "Session"
msgstr "Sessione"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "session complete"
msgstr "sessione completata"

#: ../../apps/web/src/shell/sidebar.tsx
msgid "Settings"
msgstr "Impostazioni"

#: ../../apps/web/src/features/sign-in/sign-in.tsx
msgid "Sign in with an email link"
msgstr "Accedi con un link via email"

#: ../../apps/web/src/shell/sidebar.tsx
msgid "Sign out"
msgstr "Esci"

#: ../../apps/web/src/shell/error-boundary.tsx
msgid "something went wrong"
msgstr "qualcosa è andato storto"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "This browser does not support reading words aloud."
msgstr "Questo browser non supporta la lettura ad alta voce."

#: ../../apps/web/src/features/sign-in/sign-in.tsx
msgid "This link is invalid or has expired. Request a new one."
msgstr "Questo link non è valido oppure è scaduto. Richiedine un altro."

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Try again"
msgstr "Riprova"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Try again before continuing. Do not clear your browser data: it may contain answers that have not been saved yet."
msgstr "Riprova prima di continuare. Non cancellare i dati del browser: potrebbero esserci risposte ancora da salvare."

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "type the French word"
msgstr "scrivi la parola in francese"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Well done"
msgstr "Ottimo lavoro"

#: ../../apps/web/src/shell/sidebar.tsx
msgid "Words"
msgstr "Parole"

#. placeholder {0}: view.typed || "—"
#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "you wrote: <0>{0}</0>"
msgstr "hai scritto: <0>{0}</0>"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "you're all caught up"
msgstr "sei in pari"

#: ../../apps/web/src/features/sign-in/sign-in.tsx
msgid "you@example.com"
msgstr "nome@esempio.it"

#: ../../apps/web/src/shell/error-boundary.tsx
msgid "Your answers have been saved. Reload to pick up where you left off."
msgstr "Le tue risposte sono salvate. Ricarica la pagina per riprendere da dove hai lasciato."
