msgid "{correct}/{recalls} correct answers"
msgstr "{correct}/{recalls} risposte corrette"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "{introduced, plural, one {# new word} other {# new words}}"
msgstr "{introduced, plural, one {# parola nuova} other {# parole nuove}}"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "<0>Enter</0> = Good"
msgstr "<0>Invio</0> = Normale"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "All done, for now"
msgstr "Per ora hai finito"

#: ../../apps/web/src/shell/sidebar.tsx
msgid "coming soon"
msgstr "in arrivo"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Continue"
msgstr "Continua"

#: ../../apps/web/src/features/sign-in/sign-in.tsx
msgid "Could not check whether you're signed in. Try again."
msgstr "Non è stato possibile verificare se hai già effettuato l’accesso. Riprova."

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Could not load your session"
msgstr "Non è stato possibile caricare la sessione"

#. placeholder {0}: audioError.reason
#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Could not play the audio ({0})."
msgstr "Impossibile riprodurre l’audio ({0})."

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Could not save your answers"
msgstr "Non è stato possibile salvare le risposte"

#: ../../apps/web/src/features/sign-in/sign-in.tsx
msgid "Could not send the link. Check your connection and try again."
msgstr "Non è stato possibile inviare il link. Controlla la connessione e riprova."

#: ../../apps/web/src/app.tsx
msgid "Could not sign out. Try again."
msgstr "Non è stato possibile uscire dall’account. Riprova."

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Delete all unsynced answers on this device? This cannot be undone. Progress already saved will not change."
msgstr "Vuoi eliminare tutte le risposte non ancora sincronizzate su questo dispositivo? Non potrai recuperarle. I progressi già salvati resteranno invariati."

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Delete unsynced answers and reload"
msgstr "Elimina le risposte non sincronizzate e ricarica"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Easy"
msgstr "Facile"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Good"
msgstr "Normale"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Hard"
msgstr "Difficile"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "how do you say it in French?"
msgstr "come si dice in francese?"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "I've said it aloud"
msgstr "Ho ripetuto la parola"

#: ../../apps/web/src/features/sign-in/sign-in.tsx
msgid "If this email address has access, you'll receive a link at <0>{sentTo}</0>. Open it on this device."
msgstr "Se questo indirizzo email è autorizzato ad accedere, riceverai un link a <0>{sentTo}</0>. Aprilo su questo dispositivo."

#: ../../apps/web/src/shell/sidebar.tsx
msgid "Learning language"
msgstr "Lingua studiata"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "Listen again"
msgstr "Riascolta"

#: ../../apps/web/src/features/practice/session-screen.tsx
msgid "listen and repeat aloud"
